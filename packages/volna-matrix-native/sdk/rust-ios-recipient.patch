new file mode 100644
index 0000000..ae72a98
--- /dev/null
+++ b/crates/matrix-sdk-crypto/src/recipient_policy.rs
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: Apache-2.0
+//! VOLNA's opt-in build-time, endpoint-owned direct-room recipient boundary.
+//! Compile this feature into every SDK entry point, before sync or queue replay.
+use crate::{
+    CryptoStoreError, OlmMachine,
+    olm::OutboundGroupSession,
+    store::{CryptoStoreWrapper, Result},
+};
+use ruma::{OwnedRoomId, OwnedUserId, RoomId, UserId};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+#[derive(Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Binding {
+    version: u8,
+    room_id: OwnedRoomId,
+    own: OwnedUserId,
+    peer: OwnedUserId,
+}
+
+pub(crate) fn failure() -> CryptoStoreError {
+    CryptoStoreError::backend(std::io::Error::new(
+        std::io::ErrorKind::PermissionDenied,
+        "room-key recipient policy rejected the operation",
+    ))
+}
+
+pub(crate) fn opaque_key(namespace: &str, value: &str) -> String {
+    let hash: String =
+        Sha256::digest(value.as_bytes()).iter().map(|b| format!("{b:02x}")).collect();
+    format!("volna.{namespace}.v1.{hash}")
+}
+
+impl Binding {
+    pub(crate) fn allows(&self, user: &UserId) -> bool {
+        user == self.own || user == self.peer
+    }
+    pub(crate) fn pair(&self) -> [OwnedUserId; 2] {
+        [self.own.clone(), self.peer.clone()]
+    }
+    pub(crate) async fn load(store: &CryptoStoreWrapper, room: &RoomId) -> Result<Self> {
+        let raw = store
+            .get_custom_value(&opaque_key("recipient", room.as_str()))
+            .await?
+            .ok_or_else(failure)?;
+        let binding: Self = serde_json::from_slice(&raw)?;
+        if binding.version != 1
+            || binding.room_id != room
+            || binding.own != store.policy_user_id()
+            || binding.own == binding.peer
+        {
+            return Err(failure());
+        }
+        Ok(binding)
+    }
+    pub(crate) fn accepts_session(&self, session: &OutboundGroupSession) -> bool {
+        session.recipient_policy.as_ref() == Some(&self.pair())
+            && session.sharing_view().shared_with_users().all(|u| self.allows(u))
+            && session.pending_requests().iter().all(|r| r.messages.keys().all(|u| self.allows(u)))
+    }
+}
+
+impl OlmMachine {
+    /// Bind a direct room to this account and one endpoint-selected peer.
+    /// Existing bindings are immutable across threads, processes and restarts.
+    /// Never derive the peer from a homeserver membership list. The host must
+    /// authorize this destination before calling, and before enabling its queue.
+    pub async fn bind_room_key_recipients(&self, room: &RoomId, peer: &UserId) -> Result<()> {
+        if peer == self.user_id() {
+            return Err(failure());
+        }
+        let binding = Binding {
+            version: 1,
+            room_id: room.to_owned(),
+            own: self.user_id().to_owned(),
+            peer: peer.to_owned(),
+        };
+        let key = opaque_key("recipient", room.as_str());
+        self.store().set_custom_value_if_absent(&key, serde_json::to_vec(&binding)?).await?;
+        if Binding::load(&self.store().crypto_store(), room).await? != binding {
+            return Err(failure());
+        }
+        Ok(())
+    }
+}
+
+pub(crate) async fn check_key_content(
+    store: &CryptoStoreWrapper,
+    recipient: &UserId,
+    event_type: &str,
+    content: &serde_json::Value,
+) -> Result<()> {
+    if !matches!(
+        event_type,
+        "m.room_key"
+            | "m.forwarded_room_key"
+            | "m.room_key_bundle"
+            | "io.element.msc4268.room_key_bundle"
+    ) {
+        return Ok(());
+    }
+    let room: OwnedRoomId =
+        serde_json::from_value(content.get("room_id").cloned().ok_or_else(failure)?)?;
+    if !Binding::load(store, &room).await?.allows(recipient) {
+        return Err(failure());
+    }
+    Ok(())
+}
