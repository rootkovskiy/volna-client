+// SPDX-License-Identifier: Apache-2.0
+use crate::{
+    DeviceData, EncryptionSettings,
+    machine::test_helpers::{
+        build_session_for_pair, get_machine_pair_with_session, get_prepared_machine_test_helper,
+    },
+};
+use matrix_sdk_test::async_test;
+use ruma::{TransactionId, room_id, user_id};
+use sha2::{Digest, Sha256};
+
+#[async_test]
+async fn test_recipient_policy_filters_late_member_at_real_share_boundary() {
+    let own = user_id!("@alice:example.org");
+    let peer = user_id!("@bob:example.org");
+    let service = user_id!("@volna_messaging:example.org");
+    let room = room_id!("!direct:example.org");
+    let (alice, _) = get_machine_pair_with_session(own, peer, false).await;
+    let (outsider, keys) = get_prepared_machine_test_helper(service, false).await;
+    alice
+        .store()
+        .save_device_data(&[DeviceData::from_machine_test_helper(&outsider).await.unwrap()])
+        .await
+        .unwrap();
+    let (alice, _) = build_session_for_pair(alice, outsider, keys).await;
+    let digest: String =
+        Sha256::digest(room.as_bytes()).iter().map(|b| format!("{b:02x}")).collect();
+    let key = format!("volna.recipient.v1.{digest}");
+    alice
+        .store()
+        .set_custom_value(
+            &key,
+            serde_json::to_vec(&serde_json::json!({
+                "version": 1, "room_id": room, "own": own, "peer": peer
+            }))
+            .unwrap(),
+        )
+        .await
+        .unwrap();
+    let requests = alice
+        .share_room_key(room, [own, peer, service].into_iter(), EncryptionSettings::default())
+        .await
+        .unwrap();
+    assert!(requests.iter().any(|r| r.messages.contains_key(peer)), "ordinary peer lost its key");
+    assert!(
+        requests.iter().all(|r| !r.messages.contains_key(service)),
+        "outsider received a room-key request after membership expansion"
+    );
+}
+
+async fn pair() -> (crate::OlmMachine, crate::OlmMachine) {
+    let (alice, bob) = get_machine_pair_with_session(
+        user_id!("@alice:example.org"),
+        user_id!("@bob:example.org"),
+        false,
+    )
+    .await;
+    alice.bind_room_key_recipients(room_id!("!direct:example.org"), bob.user_id()).await.unwrap();
+    (alice, bob)
+}
+
+#[async_test]
+async fn test_recipient_policy_cross_signed_service_and_valid_peer() {
+    use crate::{
+        CollectStrategy, machine::test_helpers::bootstrap_requests_to_keys_query_response,
+    };
+    let (alice, bob) = pair().await;
+    let (service, keys) =
+        get_prepared_machine_test_helper(user_id!("@volna_messaging:example.org"), false).await;
+    alice.bootstrap_cross_signing(true).await.unwrap();
+    for machine in [&bob, &service] {
+        let bootstrap = machine.bootstrap_cross_signing(true).await.unwrap();
+        let signed_device: crate::types::DeviceKeys = serde_json::from_str(
+            bootstrap
+                .upload_signatures_req
+                .signed_keys
+                .get(machine.user_id())
+                .unwrap()
+                .iter()
+                .next()
+                .unwrap()
+                .1
+                .get(),
+        )
+        .unwrap();
+        let signing_id = bootstrap
+            .upload_signing_keys_req
+            .self_signing_key
+            .as_ref()
+            .unwrap()
+            .get_first_key_and_id()
+            .unwrap()
+            .0
+            .to_owned();
+        let mut device_keys = machine
+            .get_device(machine.user_id(), machine.device_id(), None)
+            .await
+            .unwrap()
+            .unwrap()
+            .as_device_keys()
+            .to_owned();
+        device_keys.signatures.add_signature(
+            machine.user_id().to_owned(),
+            signing_id.clone(),
+            signed_device.signatures.get_signature(machine.user_id(), &signing_id).unwrap(),
+        );
+        let mut response = bootstrap_requests_to_keys_query_response(bootstrap);
+        response.device_keys.entry(machine.user_id().to_owned()).or_default().insert(
+            machine.device_id().to_owned(),
+            ruma::serde::Raw::from_json(serde_json::value::to_raw_value(&device_keys).unwrap()),
+        );
+        alice.mark_request_as_sent(&TransactionId::new(), &response).await.unwrap();
+    }
+    let (alice, service) = build_session_for_pair(alice, service, keys).await;
+    let settings = EncryptionSettings {
+        sharing_strategy: CollectStrategy::IdentityBasedStrategy,
+        ..Default::default()
+    };
+    let requests = alice
+        .share_room_key(
+            room_id!("!direct:example.org"),
+            [alice.user_id(), bob.user_id(), service.user_id()].into_iter(),
+            settings,
+        )
+        .await
+        .unwrap();
+    assert!(requests.iter().all(|r| !r.messages.contains_key(service.user_id())));
+    let payload = requests
+        .iter()
+        .filter(|r| r.event_type == "m.room.encrypted".into())
+        .find_map(|r| r.messages.get(bob.user_id()))
+        .unwrap()
+        .values()
+        .next()
+        .unwrap();
+    let event = crate::types::events::room::encrypted::EncryptedToDeviceEvent::new(
+        alice.user_id().to_owned(),
+        payload.deserialize_as_unchecked().unwrap(),
+    );
+    let changes = crate::EncryptionSyncChanges {
+        to_device_events: vec![crate::utilities::json_convert(&event).unwrap()],
+        changed_devices: &Default::default(),
+        one_time_keys_counts: &Default::default(),
+        unused_fallback_keys: None,
+        next_batch_token: None,
+    };
+    let (decrypted, _) = bob
+        .receive_sync_changes(
+            changes,
+            &crate::DecryptionSettings {
+                sender_device_trust_requirement: crate::TrustRequirement::Untrusted,
+            },
+        )
+        .await
+        .unwrap();
+    assert!(matches!(
+        decrypted.first(),
+        Some(matrix_sdk_common::deserialized_responses::ProcessedToDeviceEvent::Decrypted { .. })
+    ));
+}
+
+#[async_test]
+async fn test_recipient_policy_direct_key_events_and_secret_control() {
+    let (alice, bob) = pair().await;
+    let device = alice.get_device(bob.user_id(), bob.device_id(), None).await.unwrap().unwrap();
+    let room = room_id!("!direct:example.org");
+    let other = room_id!("!other:example.org");
+    alice.bind_room_key_recipients(other, user_id!("@carol:example.org")).await.unwrap();
+    device.set_local_trust(crate::LocalTrust::Verified).await.unwrap();
+    for event in [
+        "m.room_key",
+        "m.forwarded_room_key",
+        "m.room_key_bundle",
+        "io.element.msc4268.room_key_bundle",
+    ] {
+        assert!(
+            device.encrypt(event, serde_json::json!({"room_id": other})).await.is_err(),
+            "{event} admitted a verified contact from another chat"
+        );
+        assert!(device.encrypt(event, serde_json::json!({"room_id": []})).await.is_err());
+        assert!(device.encrypt(event, serde_json::json!({})).await.is_err());
+        assert!(device.encrypt(event, serde_json::json!({"room_id": room})).await.is_ok());
+    }
+    assert!(
+        device
+            .encrypt(
+                "m.secret.send",
+                serde_json::json!({"request_id": "fixture", "secret": "fixture"})
+            )
+            .await
+            .is_ok()
+    );
+}
+
+#[async_test]
+async fn test_recipient_policy_immutable_concurrent_and_corrupt_binding() {
+    let (alice, bob) = pair().await;
+    let room = room_id!("!racing:example.org");
+    let carol = user_id!("@carol:example.org");
+    let (first, second) = tokio::join!(
+        alice.bind_room_key_recipients(room, bob.user_id()),
+        alice.bind_room_key_recipients(room, carol)
+    );
+    assert_ne!(first.is_ok(), second.is_ok());
+    let winner = if first.is_ok() { bob.user_id() } else { carol };
+    alice.bind_room_key_recipients(room, winner).await.unwrap();
+    let key = crate::recipient_policy::opaque_key("recipient", room.as_str());
+    alice.store().set_custom_value(&key, b"broken".to_vec()).await.unwrap();
+    assert!(alice.bind_room_key_recipients(room, winner).await.is_err());
+    assert_eq!(alice.store().get_custom_value(&key).await.unwrap().unwrap(), b"broken");
+    assert!(
+        alice
+            .share_room_key(room, [winner].into_iter(), EncryptionSettings::default())
+            .await
+            .is_err()
+    );
+    assert!(
+        alice
+            .share_room_key(
+                room_id!("!unknown:example.org"),
+                [winner].into_iter(),
+                EncryptionSettings::default()
+            )
+            .await
+            .is_err()
+    );
+}
+
+#[async_test]
+async fn test_recipient_policy_reopen_old_pending_rotate_and_preserve_history() {
+    use crate::{OlmMachineBuilder, olm::OutboundGroupSession, store::types::Changes};
+    use std::sync::Arc;
+    let store = Arc::new(crate::store::MemoryStore::new());
+    let alice = OlmMachineBuilder::new(user_id!("@alice:example.org"), ruma::device_id!("ALICE"))
+        .with_crypto_store(store.clone())
+        .build()
+        .await
+        .unwrap();
+    let (bob, keys) = get_prepared_machine_test_helper(user_id!("@bob:example.org"), false).await;
+    alice
+        .store()
+        .save_device_data(&[DeviceData::from_machine_test_helper(&bob).await.unwrap()])
+        .await
+        .unwrap();
+    let (alice, bob) = build_session_for_pair(alice, bob, keys).await;
+    let room = room_id!("!direct:example.org");
+    alice.bind_room_key_recipients(room, bob.user_id()).await.unwrap();
+    let requests = alice
+        .share_room_key(room, [bob.user_id()].into_iter(), EncryptionSettings::default())
+        .await
+        .unwrap();
+    let old = alice.store().get_outbound_group_session(room).await.unwrap().unwrap();
+    let old_id = old.session_id().to_owned();
+    let mut pickle = old.pickle().await;
+    pickle.volna_recipient_policy_v1 = None;
+    let legacy = OutboundGroupSession::from_pickle(
+        alice.device_id().to_owned(),
+        Arc::new(alice.identity_keys()),
+        pickle,
+    )
+    .unwrap();
+    alice
+        .store()
+        .save_changes(Changes { outbound_group_sessions: vec![legacy], ..Default::default() })
+        .await
+        .unwrap();
+    let reopened = OlmMachineBuilder::new(alice.user_id(), alice.device_id())
+        .with_crypto_store(store)
+        .build()
+        .await
+        .unwrap();
+    assert!(
+        reopened
+            .encrypt_room_event(
+                room,
+                ruma::events::room::message::RoomMessageEventContent::text_plain("fixture")
