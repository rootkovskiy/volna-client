+        crate::recipient_policy::opaque_key("quarantine", &format!("{}\0{}", room, old_id));
+    reopened.store().set_custom_value(&archive, b"broken".to_vec()).await.unwrap();
+    assert!(
+        reopened
+            .share_room_key(room, [bob.user_id()].into_iter(), EncryptionSettings::default())
+            .await
+            .is_err(),
+        "a corrupt existing archive must not permit replacement of the active legacy queue"
+    );
+    let retained = reopened.store().get_outbound_group_session(room).await.unwrap().unwrap();
+    assert_eq!(old_id, retained.session_id());
+    assert!(!retained.pending_requests().is_empty());
+    assert_eq!(reopened.store().get_custom_value(&archive).await.unwrap().unwrap(), b"broken");
+    // Remove only the deliberately corrupted test fixture to exercise normal rotation.
+    reopened.store().remove_custom_value(&archive).await.unwrap();
+    let new_requests = reopened
+        .share_room_key(room, [bob.user_id()].into_iter(), EncryptionSettings::default())
+        .await
+        .unwrap();
+    assert!(!new_requests.is_empty());
+    let new = reopened.store().get_outbound_group_session(room).await.unwrap().unwrap();
+    assert_ne!(old_id, new.session_id());
+    let archived: crate::olm::PickledOutboundGroupSession = serde_json::from_slice(
+        &reopened.store().get_custom_value(&archive).await.unwrap().unwrap(),
+    )
+    .unwrap();
+    assert!(!archived.requests.is_empty());
+    assert!(reopened.store().get_inbound_group_session(room, &old_id).await.unwrap().is_some());
+    reopened
+        .mark_request_as_sent(
+            &requests[0].txn_id,
+            &ruma::api::client::to_device::send_event_to_device::v3::Response::new(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        new.session_id(),
+        reopened.store().get_outbound_group_session(room).await.unwrap().unwrap().session_id()
+    );
+    reopened
+        .encrypt_room_event(
+            room,
+            ruma::events::room::message::RoomMessageEventContent::text_plain("fixture"),
+        )
+        .await
+        .unwrap();
+}
