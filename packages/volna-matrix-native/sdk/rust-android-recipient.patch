+#[async_test]
+async fn test_recipient_policy_filters_late_member_at_real_share_boundary() {
+    let own = user_id!("@alice:example.org");
+    let peer = user_id!("@bob:example.org");
+    let service = user_id!("@volna_messaging:example.org");
+    let room = room_id!("!direct:example.org");
+    let (alice, _) = get_machine_pair_with_session(own, peer, false).await;
+    let (outsider, keys) = get_prepared_machine_test_helper(service, false).await;
+    alice
+        .store()
+        .save_device_data(&[DeviceData::from_machine_test_helper(&outsider).await.unwrap()])
+        .await
+        .unwrap();
+    let (alice, _) = build_session_for_pair(alice, outsider, keys).await;
+    let digest: String =
+        Sha256::digest(room.as_bytes()).iter().map(|b| format!("{b:02x}")).collect();
+    let key = format!("volna.recipient.v1.{digest}");
+    alice
+        .store()
+        .set_custom_value(
+            &key,
+            serde_json::to_vec(&serde_json::json!({
+                "version": 1, "room_id": room, "own": own, "peer": peer
+            }))
+            .unwrap(),
+        )
+        .await
+        .unwrap();
+    let requests = alice
+        .share_room_key(room, [own, peer, service].into_iter(), EncryptionSettings::default())
+        .await
+        .unwrap();
+    assert!(requests.iter().any(|r| r.messages.contains_key(peer)), "ordinary peer lost its key");
+    assert!(
+        requests.iter().all(|r| !r.messages.contains_key(service)),
+        "outsider received a room-key request after membership expansion"
+    );
+}
