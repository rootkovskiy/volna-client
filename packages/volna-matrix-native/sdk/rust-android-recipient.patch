     /// # Arguments
     ///
     /// * `room_id` - The id of the room this session is used for.
+    #[cfg(feature = "automatic-room-key-forwarding")]
     pub async fn get_or_load(&self, room_id: &RoomId) -> Option<OutboundGroupSession> {
