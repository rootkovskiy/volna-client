+    /// Import encrypted backup entries. Authentication is verified inside Rust
+    /// against the locally held, version-bound recovery secret. No caller-supplied
+    /// plaintext flag, server metadata, file import or SAS action grants this trust.
+    pub async fn import_encrypted_room_keys(
+        &self,
+        encrypted: BTreeMap<OwnedRoomId, BTreeMap<String, serde_json::Value>>,
+        version: &str,
+        progress: impl Fn(usize, usize),
+    ) -> Result<RoomKeyImportResult, CryptoStoreError> {
+        let keys = self.store.load_backup_keys().await?;
+        // A preserved predecessor version may use the same recovery secret.
+        // Authentication is bound to that secret and the encrypted account/room/
+        // session context, never to server-provided version metadata.
+        let secret = keys.decryption_key.ok_or_else(||
+            CryptoStoreError::backend(AuthenticatedBackupError))?;
+        let count: usize = encrypted.values().map(|v| v.len()).sum();
+        if count > 1024 { return Err(CryptoStoreError::backend(AuthenticatedBackupError)); }
+        let mut sessions = Vec::new();
+        let mut processed = 0;
+        for (room, entries) in encrypted {
+            for (session, ciphertext) in entries {
+                let serialized = serde_json::to_string(&ciphertext)?;
+                if let Ok(session) = authenticated::decrypt(&secret, self.store.user_id(),
+                    &room, &session, &serialized).await {
+                    sessions.push(session);
+                }
+                processed += 1;
+                progress(processed, count);
+            }
+        }
+        // A concurrently replaced recovery key/version must not admit late data.
+        let current = self.store.load_backup_keys().await?;
+        if current.decryption_key.as_ref().map(|k| k.megolm_v1_public_key().to_base64())
+                != Some(secret.megolm_v1_public_key().to_base64()) {
+            return Err(CryptoStoreError::backend(AuthenticatedBackupError));
+        }
+        let mut result = self.store.import_sessions_impl(sessions.into_iter(), Some(version), |_, _| {}).await?;
+        result.total_count = count;
+        Ok(result)
     }
 
     /// Import the given room keys into our store.
