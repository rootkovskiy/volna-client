+    pub fn bind_room_key_recipients(
+        &self,
+        room_id: &identifiers::RoomId,
+        peer_id: &identifiers::UserId,
+    ) -> Promise {
+        let _guard = dispatcher::set_default(&self.tracing_subscriber);
+        let room = room_id.inner.clone();
+        let peer = peer_id.inner.clone();
+        let me = self.inner.clone();
+        future_to_promise(async move {
+            me.bind_room_key_recipients(&room, &peer).await?;
+            Ok(JsValue::UNDEFINED)
+        })
+    }
