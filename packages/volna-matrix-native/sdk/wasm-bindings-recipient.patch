+    /// Import bounded encrypted backup JSON. MSC4048 authentication and sender
+    /// provenance are verified in Rust, never from a caller's trust boolean.
+    #[wasm_bindgen(js_name = "importEncryptedRoomKeyBackup", unchecked_return_type = "Promise<RoomKeyImportResult>")]
+    pub fn import_encrypted_room_key_backup(
+        &self,
+        encrypted_json: String,
+        backup_version: String,
+    ) -> Result<Promise, JsValue> {
+        let _guard = dispatcher::set_default(&self.tracing_subscriber);
+        if encrypted_json.len() > 8 * 1024 * 1024 {
+            return Err(JsValue::from_str("Encrypted backup batch exceeds limit"));
+        }
+        let encrypted = serde_json::from_str(&encrypted_json)
+            .map_err(|_| JsValue::from_str("Invalid encrypted backup batch"))?;
+        let me = self.inner.clone();
+        Ok(future_to_promise(async move {
+            let result: RoomKeyImportResult = me.backup_machine()
+                .import_encrypted_room_keys(encrypted, &backup_version, |_, _| {}).await?.into();
             Ok(result)
