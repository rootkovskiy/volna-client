+impl RoomKeyBackupInfo {
+    /// Mark a version for VOLNA's MSC4048 v1 backup extension before signing.
+    pub fn with_authenticated_backup(mut self, predecessor: Option<String>) -> Self {
+        if let Self::MegolmBackupV1Curve25519AesSha2(ref mut data) = self {
+            data.extra.insert("social.volna.authenticated_backup".into(), Value::from(1));
+            if let Some(version) = predecessor {
+                data.extra.insert("social.volna.backup_parent_version".into(), Value::from(version));
+            }
+        }
+        self
+    }
+
+    /// This marker selects backup migration only; it never grants session trust.
+    pub fn is_authenticated_backup(&self) -> bool {
+        matches!(self, Self::MegolmBackupV1Curve25519AesSha2(data)
+            if data.extra.get("social.volna.authenticated_backup").and_then(Value::as_u64) == Some(1))
+    }
+
+    /// One preserved legacy version, using the same recovery secret.
+    pub fn backup_parent_version(&self) -> Option<&str> {
+        match self {
+            Self::MegolmBackupV1Curve25519AesSha2(data) if self.is_authenticated_backup() =>
+                data.extra.get("social.volna.backup_parent_version").and_then(Value::as_str)
+                    .filter(|v| !v.is_empty() && v.len() <= 128),
+            _ => None,
+        }
+    }
+}
