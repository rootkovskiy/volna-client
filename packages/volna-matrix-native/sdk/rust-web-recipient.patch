+            let tx = store
+                .inner
+                .transaction(keys::CORE)
+                .with_mode(TransactionMode::Readwrite)
+                .build()
+                .unwrap();
+            tx.object_store(keys::CORE).unwrap().put(&value).with_key(key.clone()).build().unwrap();
+            tx.commit().await.unwrap();
+            store.set_custom_value_if_absent(name, b"replacement".to_vec()).await.unwrap();
+            assert!(store.get_custom_value(name).await.unwrap().is_none());
+            let tx = store
+                .inner
+                .transaction(keys::CORE)
+                .with_mode(TransactionMode::Readonly)
+                .build()
+                .unwrap();
+            assert_eq!(
+                tx.object_store(keys::CORE).unwrap().count().with_query(&key).await.unwrap(),
+                1
+            );
+        }
+    }
