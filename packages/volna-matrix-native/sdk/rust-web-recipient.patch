+// Copyright 2026 VOLNA contributors
+// SPDX-License-Identifier: Apache-2.0
+//! MSC4048's backwards-compatible v1 backup MAC, pinned at proposal revision
+//! 20b767f5f4ac616b10237c2fb23a1b4bfc8baa3f. No legacy key is promoted by import.
+//!
+//! VOLNA's encrypted context retains the SDK's already-established sender data
+//! and binds the account/room/session. Only this MAC-verifying Rust path may
+//! restore that context; plaintext exports and forwarded keys do not carry it.
+
+use hkdf::Hkdf;
+use hmac::{Hmac, KeyInit, Mac, digest::FixedOutput};
+use ruma::{RoomId, UserId, canonical_json::to_canonical_value, serde::Raw};
+use serde_json::{Value, json};
+use sha2::Sha256;
+use thiserror::Error;
+use vodozemac::{base64_decode, base64_encode, pk_encryption::PkEncryption};
+use zeroize::{Zeroize, Zeroizing};
+
+use super::MegolmV1BackupKey;
+use crate::{
+    olm::{BackedUpRoomKey, ExportedRoomKey, InboundGroupSession, SenderData},
+    store::types::BackupDecryptionKey,
+};
+
+const MAC_FIELD: &str = "org.matrix.msc4048.backup_mac";
+const UNAUTHENTICATED: &str = "org.matrix.msc4048.unauthenticated";
+const CONTEXT: &str = "social.volna.backup_context";
+const MAX_SESSION_BYTES: usize = 65_536;
+
+struct SecretJson(Value);
+impl Drop for SecretJson {
+    fn drop(&mut self) {
+        fn wipe(value: &mut Value) {
+            match value {
+                Value::String(s) => s.zeroize(),
+                Value::Array(a) => a.iter_mut().for_each(wipe),
+                Value::Object(o) => o.values_mut().for_each(wipe),
+                _ => {},
+            }
+        }
+        wipe(&mut self.0);
+    }
+}
+
+/// An untrusted backup entry failed validation. Never attach its contents to logs.
+#[derive(Debug, Error)]
+#[error("Invalid authenticated room-key backup")]
+pub struct AuthenticatedBackupError;
+
+fn mac_key(key: &BackupDecryptionKey) -> Zeroizing<[u8; 32]> {
+    let mut result = Zeroizing::new([0; 32]);
+    Hkdf::<Sha256>::new(None, key.as_bytes())
+        .expand(b"MATRIX_BACKUP_MAC_KEY", result.as_mut())
+        .expect("32-byte HKDF output is valid");
+    result
+}
+
+fn canonical_ciphertext(value: &Value) -> Result<String, AuthenticatedBackupError> {
+    let mut object = value.as_object().cloned().ok_or(AuthenticatedBackupError)?;
+    object.remove("unsigned");
+    object.remove("signatures");
+    to_canonical_value(object).map(|v| v.to_string()).map_err(|_| AuthenticatedBackupError)
+}
+
+fn create_mac(key: &BackupDecryptionKey, data: &Value) -> Result<String, AuthenticatedBackupError> {
+    let key = mac_key(key);
+    let mut mac = Hmac::<Sha256>::new_from_slice(key.as_ref()).expect("valid HMAC key length");
+    mac.update(canonical_ciphertext(data)?.as_bytes());
+    Ok(base64_encode(mac.finalize_fixed()))
+}
+
+fn verify_mac(key: &BackupDecryptionKey, data: &Value) -> Result<bool, AuthenticatedBackupError> {
+    let Some(tag) = data.get("unsigned").and_then(|v| v.get(MAC_FIELD)) else {
+        return Ok(false);
+    };
+    let tag = tag.as_str().ok_or(AuthenticatedBackupError)?;
+    if tag.len() != 43 { return Err(AuthenticatedBackupError); }
+    let tag = base64_decode(tag).map_err(|_| AuthenticatedBackupError)?;
+    if tag.len() != 32 { return Err(AuthenticatedBackupError); }
+    let key = mac_key(key);
+    let mut mac = Hmac::<Sha256>::new_from_slice(key.as_ref()).expect("valid HMAC key length");
+    mac.update(canonical_ciphertext(data)?.as_bytes());
+    mac.verify_slice(&tag).map_err(|_| AuthenticatedBackupError)?;
+    Ok(true)
+}
+
+fn known_sender(data: &SenderData) -> bool {
+    matches!(data, SenderData::SenderVerified(_) | SenderData::SenderUnverified(_)
+        | SenderData::VerificationViolation(_))
+}
+
+/// Encrypt an SDK session using the existing v1 cipher plus MSC4048 authentication.
+pub(super) async fn encrypt(
+    session: InboundGroupSession,
+    key: &MegolmV1BackupKey,
+    secret: &BackupDecryptionKey,
+    user: &UserId,
+) -> Result<Raw<ruma::api::client::backup::KeyBackupData>, vodozemac::pk_encryption::Error> {
+    // The caller matches the private key to the active backup public key/version.
+    let mut plaintext = SecretJson(serde_json::to_value(session.to_backup().await)
+        .expect("room key is serializable"));
+    // SenderData is only established by authenticated Olm receipt or a previous
+    // authenticated import. Untrusted file/legacy imports retain UnknownDevice.
+    let authenticated = known_sender(&session.sender_data) && session.forwarder_data.is_none()
+        && (!session.has_been_imported() || session.has_authenticated_backup());
+    if authenticated {
+        plaintext.0[CONTEXT] = json!({ "version": 1, "user_id": user,
+            "room_id": session.room_id(), "session_id": session.session_id(),
+            "sender_data": session.sender_data });
+    } else {
+        plaintext.0[UNAUTHENTICATED] = json!("m.undefined");
+    }
+    let plaintext = Zeroizing::new(serde_json::to_vec(&plaintext.0).expect("room key is serializable"));
+    let public = vodozemac::Curve25519PublicKey::from_base64(&key.to_base64())
+        .expect("stored backup public key is valid");
+    let message = PkEncryption::from_key(public).encrypt(&plaintext)?;
+    let mut data = json!({ "ephemeral": message.ephemeral_key.to_base64(),
+        "ciphertext": base64_encode(message.ciphertext), "mac": base64_encode(message.mac) });
+    data["unsigned"] = json!({ MAC_FIELD: create_mac(secret, &data).expect("generated backup is canonical") });
+    let result = json!({ "first_message_index": session.first_known_index(),
+        "forwarded_count": u8::from(session.has_been_imported()),
+        // Server merge preference for proven origin, not a claim of peer SAS.
+        // The importer ignores this unauthenticated metadata entirely.
+        "is_verified": authenticated,
+        "session_data": data });
+    Ok(Raw::from_json_string(result.to_string()).expect("backup entry is serializable"))
+}
+
+impl BackupDecryptionKey {
+    /// Check a present MSC4048 MAC before decrypting v1 data. This returns bytes,
+    /// not sender trust; only the version-bound importer restores sender data.
+    pub fn decrypt_v1_with_authentication(&self, serialized: &str) -> Result<String, AuthenticatedBackupError> {
+        if serialized.len() > MAX_SESSION_BYTES { return Err(AuthenticatedBackupError); }
+        let data: Value = serde_json::from_str(serialized).map_err(|_| AuthenticatedBackupError)?;
+        verify_mac(self, &data)?;
+        let field = |name: &str| data.get(name).and_then(Value::as_str).ok_or(AuthenticatedBackupError);
+        self.decrypt_v1(field("ephemeral")?, field("mac")?, field("ciphertext")?)
+            .map_err(|_| AuthenticatedBackupError)
+    }
+}
+
+/// Verify ciphertext before interpreting sender provenance. A missing MAC retains
+/// legacy import semantics; an invalid present MAC is an error, never a fallback.
+pub(super) async fn decrypt(
+    secret: &BackupDecryptionKey,
+    user: &UserId,
+    room: &RoomId,
+    session_id: &str,
+    serialized: &str,
+) -> Result<InboundGroupSession, AuthenticatedBackupError> {
+    if serialized.len() > MAX_SESSION_BYTES || session_id.len() > 128 {
+        return Err(AuthenticatedBackupError);
+    }
+    let data: Value = serde_json::from_str(serialized).map_err(|_| AuthenticatedBackupError)?;
+    let authenticated = verify_mac(secret, &data)?;
+    let plaintext = Zeroizing::new(secret.decrypt_v1_with_authentication(serialized)?);
+    let value = SecretJson(serde_json::from_str(&plaintext).map_err(|_| AuthenticatedBackupError)?);
+    let key: BackedUpRoomKey = serde_json::from_str(&plaintext).map_err(|_| AuthenticatedBackupError)?;
+    // The intrinsic Megolm session id must match routing, including legacy input.
+    let exported = ExportedRoomKey::from_backed_up_room_key(room.to_owned(), session_id.to_owned(), key);
+    let mut session = InboundGroupSession::try_from(&exported).map_err(|_| AuthenticatedBackupError)?;
+    let pickle = session.pickle().await;
+    let roundtrip = InboundGroupSession::from_pickle(pickle).map_err(|_| AuthenticatedBackupError)?;
+    if roundtrip.session_id() != session_id { return Err(AuthenticatedBackupError); }
+    if authenticated && value.0.get(UNAUTHENTICATED).is_none() && value.0.get("unauthenticated").is_none() {
+        let context = value.0.get(CONTEXT).ok_or(AuthenticatedBackupError)?;
+        if context.get("version").and_then(Value::as_u64) != Some(1)
+            || context.get("user_id").and_then(Value::as_str) != Some(user.as_str())
+            || context.get("room_id").and_then(Value::as_str) != Some(room.as_str())
+            || context.get("session_id").and_then(Value::as_str) != Some(session_id) {
+            return Err(AuthenticatedBackupError);
+        }
+        let sender: SenderData = serde_json::from_value(context.get("sender_data")
+            .cloned().ok_or(AuthenticatedBackupError)?).map_err(|_| AuthenticatedBackupError)?;
+        if !known_sender(&sender) { return Err(AuthenticatedBackupError); }
+        session.restore_authenticated_backup_sender(sender);
+    }
+    Ok(session)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use matrix_sdk_test::async_test;
+    use ruma::{device_id, room_id, user_id};
+    use crate::olm::{Account, KnownSenderData};
+
+    #[test]
+    fn test_msc4048_mac_matches_independent_python_vector() {
+        let secret = BackupDecryptionKey::from_bytes(&std::array::from_fn(|i| i as u8));
+        let data = json!({ "ciphertext": "AQID", "ephemeral": "BAUG", "mac": "BwgJ" });
+        assert_eq!(create_mac(&secret, &data).unwrap(), "MX82TENnNpcPL0JIZJj+6N/8nnrF5t8xon7g3TrYZb8");
+    }
+
+    async fn fixture() -> (InboundGroupSession, BackupDecryptionKey, MegolmV1BackupKey) {
+        let account = Account::new(user_id!("@alice:example.org"));
+        let (_, mut session) = account.create_group_session_pair_with_defaults(room_id!("!room:example.org")).await;
+        session.sender_data = SenderData::SenderUnverified(KnownSenderData {
+            user_id: user_id!("@alice:example.org").to_owned(),
+            device_id: Some(device_id!("ALICE").to_owned()),
+            master_key: Box::new(account.identity_keys().ed25519),
+        });
+        let secret = BackupDecryptionKey::new();
+        let public = secret.megolm_v1_public_key();
+        (session, secret, public)
+    }
+
+    async fn encrypted(session: InboundGroupSession, secret: &BackupDecryptionKey, public: &MegolmV1BackupKey) -> Value {
+        let raw = encrypt(session, public, secret, user_id!("@owner:example.org")).await.unwrap();
+        let value: Value = serde_json::from_str(raw.json().get()).unwrap();
+        value["session_data"].clone()
+    }
+
+    #[async_test]
+    async fn test_authenticated_backup_survives_pickle_and_second_backup() {
+        let (session, secret, public) = fixture().await;
+        let data = encrypted(session.clone(), &secret, &public).await;
+        let recovered = decrypt(&secret, user_id!("@owner:example.org"), session.room_id(), session.session_id(), &data.to_string()).await.unwrap();
+        assert!(recovered.has_been_imported()); // Do not pretend this was live Olm.
+        assert_eq!(recovered.sender_data, session.sender_data);
+        assert!(recovered.has_authenticated_backup());
+        let reopened = InboundGroupSession::from_pickle(recovered.pickle().await).unwrap();
+        let data = encrypted(reopened, &secret, &public).await;
+        let recovered = decrypt(&secret, user_id!("@owner:example.org"), session.room_id(), session.session_id(), &data.to_string()).await.unwrap();
+        assert_eq!(recovered.sender_data, session.sender_data);
+        assert!(recovered.has_authenticated_backup());
+    }
+
+    #[async_test]
+    async fn test_authenticated_backup_rejects_wrong_secret_mutation_and_context() {
+        let (session, secret, public) = fixture().await;
+        let data = encrypted(session.clone(), &secret, &public).await;
+        assert!(decrypt(&BackupDecryptionKey::new(), user_id!("@owner:example.org"), session.room_id(), session.session_id(), &data.to_string()).await.is_err());
+        for field in ["ciphertext", "ephemeral", "mac"] {
+            let mut changed = data.clone(); changed[field] = json!("AAAA");
+            assert!(decrypt(&secret, user_id!("@owner:example.org"), session.room_id(), session.session_id(), &changed.to_string()).await.is_err());
+        }
+        assert!(decrypt(&secret, user_id!("@attacker:example.org"), session.room_id(), session.session_id(), &data.to_string()).await.is_err());
+        assert!(decrypt(&secret, user_id!("@owner:example.org"), room_id!("!other:example.org"), session.session_id(), &data.to_string()).await.is_err());
+        assert!(decrypt(&secret, user_id!("@owner:example.org"), session.room_id(), "different-session", &data.to_string()).await.is_err());
+    }
+
+    #[async_test]
+    async fn test_stripped_mac_and_plaintext_exports_never_authenticate() {
+        let (session, secret, public) = fixture().await;
+        let mut data = encrypted(session.clone(), &secret, &public).await;
+        data.as_object_mut().unwrap().remove("unsigned");
+        let recovered = decrypt(&secret, user_id!("@owner:example.org"), session.room_id(), session.session_id(), &data.to_string()).await.unwrap();
+        assert!(!known_sender(&recovered.sender_data));
+        assert!(!recovered.has_authenticated_backup());
+        let ordinary = InboundGroupSession::try_from(&session.export().await).unwrap();
+        assert!(!known_sender(&ordinary.sender_data));
+    }
+
+    #[async_test]
+    async fn test_rebacking_legacy_keys_does_not_launder_their_provenance() {
+        let (session, secret, public) = fixture().await;
+        let legacy = InboundGroupSession::try_from(&session.export().await).unwrap();
+        let data = encrypted(legacy, &secret, &public).await;
+        assert!(verify_mac(&secret, &data).unwrap());
+        let recovered = decrypt(&secret, user_id!("@owner:example.org"), session.room_id(), session.session_id(), &data.to_string()).await.unwrap();
+        assert!(!known_sender(&recovered.sender_data));
+        assert!(!recovered.has_authenticated_backup());
+    }
+
+    #[async_test]
+    async fn test_additional_signed_fields_and_invalid_present_tags_are_rejected() {
+        let (session, secret, public) = fixture().await;
+        let data = encrypted(session.clone(), &secret, &public).await;
+        let mut changed = data.clone(); changed["extra"] = json!(1);
+        assert!(verify_mac(&secret, &changed).is_err());
+        for tag in [Value::Null, json!(1), json!(""), json!("A".repeat(43))] {
+            let mut changed = data.clone(); changed["unsigned"][MAC_FIELD] = tag;
+            assert!(secret.decrypt_v1_with_authentication(&changed.to_string()).is_err());
+        }
+        assert!(secret.decrypt_v1_with_authentication(&" ".repeat(MAX_SESSION_BYTES + 1)).is_err());
+    }
+}
