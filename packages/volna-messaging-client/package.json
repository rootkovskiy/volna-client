  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "release:evidence": "node scripts/build-release-evidence.mjs",
    "verify:boundary": "node scripts/verify-public-boundary.mjs",
    "verify": "pnpm run verify:boundary && pnpm typecheck && pnpm test"
  },
