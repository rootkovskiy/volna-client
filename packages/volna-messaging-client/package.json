      "default": "./src/expo-storage-adapter.ts"
    },
    "./expo-secure-messaging": {
      "types": "./src/expo-secure-messaging.ts",
      "import": "./src/expo-secure-messaging.ts",
      "default": "./src/expo-secure-messaging.ts"
    },
    "./secure-messaging-client": {
      "types": "./src/secure-messaging-client.d.mts",
      "import": "./src/secure-messaging-client.mjs",
      "default": "./src/secure-messaging-client.mjs"
    },
    "./device-transfer": {
      "types": "./src/device-transfer.d.mts",
      "import": "./src/device-transfer.mjs",
      "default": "./src/device-transfer.mjs"
