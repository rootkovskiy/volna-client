{
  "name": "@volna/messaging-client",
  "version": "0.1.0",
  "description": "Public client-side trust boundary and wire contracts for VOLNA end-to-end encrypted messages.",
  "license": "Apache-2.0",
  "private": false,
  "packageManager": "pnpm@11.7.0",
  "volnaVerification": {
    "packageManager": "pnpm@11.7.0"
  },
  "type": "commonjs",
  "main": "src/index.js",
