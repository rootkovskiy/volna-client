{
  "name": "@volna/client",
  "version": "1.0.0",
  "description": "Complete public source boundary for the VOLNA Expo client release candidate.",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "pnpm --filter mobile typecheck && pnpm --filter @volna/messaging-client typecheck",
    "test": "pnpm --filter @volna/messaging-client test && node --test release/test/*.test.mjs",
    "verify:boundary": "node release/scripts/verify-public-client-boundary.mjs",
    "verify": "pnpm verify:boundary && pnpm typecheck && pnpm test",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "release:evidence": "node release/scripts/build-release-evidence.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@volna/messaging-client": "workspace:*",
    "expo": "54.0.36",
    "expo-audio": "1.1.1",
    "expo-auth-session": "7.0.11",
    "expo-calendar": "15.0.8",
    "expo-camera": "17.0.10",
    "expo-clipboard": "8.0.8",
    "expo-constants": "18.0.13",
    "expo-crypto": "15.0.9",
    "expo-document-picker": "14.0.8",
    "expo-haptics": "15.0.8",
    "expo-image": "3.0.11",
    "expo-image-manipulator": "14.0.8",
    "expo-image-picker": "17.0.11",
    "expo-linking": "8.0.12",
    "expo-location": "19.0.8",
    "expo-notifications": "0.32.17",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "expo-web-browser": "15.0.11",
    "lucide-react-native": "0.562.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.15.0",
    "socket.io-client": "4.8.3",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "metro": "0.83.3",
    "typescript": "5.9.3"
  }
}
