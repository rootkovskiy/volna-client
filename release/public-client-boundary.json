{
  "schemaVersion": 1,
  "name": "@volna/client",
  "license": "Apache-2.0",
  "releaseDirectory": "release",
  "firstPartyRuntimeRoots": [
    "app",
    "apps/mobile",
    "packages/content-policy",
    "packages/music-taxonomy",
    "packages/volna-messaging-client",
    "packages/volna-key-directory-witness",
    "packages/volna-key-transparency-log",
    "public"
  ],
  "rootRuntimeFiles": [
    "app.json",
    "eas.json",
    "index.ts",
    "metro.config.cjs",
    "tsconfig.json"
  ],
  "excludedNonRuntimePaths": [
    "apps/mobile/AGENTS.md",
    "apps/mobile/CLAUDE.md"
  ],
  "forbiddenSourceRoots": [
    "apps/api",
    "docs",
    "observability",
    "scripts"
  ],
  "allowedWorkspaceImports": [
    "@volna/content-policy",
    "@volna/messaging-client",
    "@volna/music-taxonomy"
  ],
  "allowedClientEnvironmentVariables": [
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_SENTRY_DSN"
  ],
  "allowedWitnessEnvironmentVariables": [
    "VOLNA_DIRECTORY_RECEIPT_PUBLIC_KEY",
    "WITNESS_ALLOWED_ORIGINS",
    "WITNESS_DATABASE_POOL_SIZE",
    "WITNESS_DATABASE_URL",
    "WITNESS_ID",
    "WITNESS_MAX_CONCURRENT_OBSERVATIONS",
    "WITNESS_PORT",
    "WITNESS_SIGNING_KEY",
    "WITNESS_TEST_DATABASE_URL"
    ,"KT_APPEND_TOKEN"
    ,"KT_LISTEN"
    ,"KT_LOG_PRIVATE_KEY"
    ,"KT_LOG_PRIVATE_KEY_FILE"
    ,"KT_STORAGE_DIR"
    ,"KT_TEST_ONLY_ALLOW_UNWITNESSED"
    ,"KT_WITNESS_POLICY"
    ,"KT_WITNESS_POLICY_FILE"
    ,"VOLNA_ENV"
  ],
  "requiredArchiveRootFiles": [
    ".gitattributes",
    ".gitignore",
    ".github/dependabot.yml",
    ".github/workflows/codeql.yml",
    ".github/workflows/verify.yml",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "DEPENDENCIES.md",
    "LICENSE",
    "NOTICE",
    "patches/image-size@1.2.1.patch",
    "README.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "rust-toolchain.toml"
  ]
}
